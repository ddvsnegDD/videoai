# ============================================
# VideoAI — переменные окружения
# Скопируйте в .env и заполните реальными значениями
# ============================================

# ── Общее ──
NODE_ENV=production
PORT=3000

# ── База данных (PostgreSQL) ──
# Локальный: postgresql://videoai:ПАРОЛЬ@localhost:5432/videoai
# Railway:   postgresql://postgres:...@...railway.app:5432/railway
DATABASE_URL=

# ── Авторизация (JWT) ──
# Секрет для подписи JWT-токенов (генерируйте: openssl rand -base64 32)
JWT_SECRET=

# Приветственные кредиты для нового пользователя (по умолчанию 50)
WELCOME_CREDITS=50

# Email администратора — получает role='admin' при старте сервера
ADMIN_EMAIL=

# ── Email (SMTP Mail.ru) ──
SMTP_HOST=smtp.mail.ru
SMTP_PORT=587
SMTP_USER=noreply@ddvideoai.ru
SMTP_PASS=
EMAIL_FROM=noreply@ddvideoai.ru

# ── fal.ai (генерация видео и картинок) ──
FAL_KEY=

# Стоимость генерации в кредитах
CREDITS_WAN=40                  # Kling 2.5 turbo (эконом, ~$0.21/ролик)
CREDITS_COSMOS=75               # Cosmos 3 Super (стандарт, ~$0.40-0.50/ролик)
CREDITS_VEO=90                  # Veo 3.1 fast (премиум, ~$1.20/ролик)
CREDITS_IMAGE=13                # Nano Banana 2 (картинка, ~$0.08)

# ── GigaChat (LLM, построение промптов) ──
GIGACHAT_AUTH_KEY=               # Basic-токен OAuth (Base64 client_id:secret)
GIGACHAT_SCOPE=GIGACHAT_API_PERS # GIGACHAT_API_PERS или GIGACHAT_API_CORP
GIGACHAT_MODEL=GigaChat          # Модель (по умолчанию GigaChat)

# ── Yandex Object Storage (S3-совместимое) ──
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=videoai-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── ЮKassa (платежи) ──
YOOKASSA_SHOP_ID=                # shopId из ЛК ЮKassa
YOOKASSA_SECRET_KEY=             # Секретный ключ API (НЕ коммитить в Git!)
APP_URL=https://ddvideoai.ru     # Базовый URL для redirect после оплаты

# ── Legacy ЮMoney (можно удалить после полного перехода) ──
# YOOMONEY_WALLET=
# YOOMONEY_NOTIFICATION_SECRET=
